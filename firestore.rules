rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Open rules for development. Covers legacy collections and v2 payroll paths
    // (employees_v2, attendance_v2, payroll_period_earnings_v2, payroll_periods_v2/.../payments,
    // migration_v2_status for migration-tool UI).
    // Tighten before production.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2035, 1, 1);
    }
  }
}