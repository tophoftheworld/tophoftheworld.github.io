{
  "hosting": [
    {
      "target": "info",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "functions/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ],
      "rewrites": [
        { "source": "/admin", "destination": "/admin.html" },
        { "source": "/admin-sales", "destination": "/admin-sales.html" },
        { "source": "/requirements", "destination": "/requirements.html" }
      ]
    },
    {
      "target": "requirements",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "functions/**",
        "index.html",
        "admin.html"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ],
      "rewrites": [
        { "source": "**", "destination": "/requirements.html" }
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      ".env"
    ]
  }
}
