# Copy to .env and fill in (never commit .env).
# SHOPIFY_SHOP: store subdomain only (e.g. 9576df-4 for 9576df-4.myshopify.com)
SHOPIFY_SHOP=your-store-subdomain

# Option A: Admin API access token after installing the custom app
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Client credentials (token exchanged automatically; expires every 24h)
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required Admin API scopes (install / release new app version):
#   read_orders, read_customers, read_products
#   write_orders, write_fulfillments, write_merchant_managed_fulfillment_orders

# Optional
# PORT=3847
# SHOPIFY_API_VERSION=2024-10
