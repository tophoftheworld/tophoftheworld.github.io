# Copy to .env and adjust (optional — GOOGLE_APPLICATION_CREDENTIALS is usually enough)
PORT=8787
# Comma-separated allowed origins for CORS, or * for dev only
CORS_ORIGIN=*

# Document AI processor resource name (Invoice Parser in your case), for /scan-documentai.
# Format:
# projects/<projectId>/locations/<region>/processors/<processorId>
DOCUMENT_AI_PROCESSOR_NAME=projects/YOUR_PROJECT_ID/locations/asia-southeast1/processors/YOUR_PROCESSOR_ID
