rules_version = '2';

// Target rules for workshop collections. Before deploying, merge into the root
// /firestore.rules and remove or narrow the catch-all open rule — otherwise
// the project-wide dev rule still allows all writes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /workshop_events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /workshop_sessions/{sessionId} {
      allow read: if true;
      allow write: if false;
    }
    match /workshop_bookings/{bookingId} {
      allow read, write: if false;
    }
    match /workshop_config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
