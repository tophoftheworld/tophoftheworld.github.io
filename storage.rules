rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staff management profile photos
    match /staff-photos/{employeeId} {
      allow read, write: if true;
    }

    match /menu-creator-photos/{fileName} {
      allow read, write: if true;
    }

    // Allow access to payment_confirmations folder
    match /payment_confirmations/{allPaths=**} {
      allow read, write: if true;
    }

    // Admin payroll v2 payment screenshots (canonical admin-payroll)
    match /payroll_periods_v2_screenshots/{allPaths=**} {
      allow read, write: if true;
    }

    // Matcha Hop log photos
    match /logs/{allPaths=**} {
      allow read, write: if true;
    }

    // Default rule for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
