rules_version = '2';

// Firebase Storage rules for Matchanese staff management
service firebase.storage {
  match /b/{bucket}/o {
    // Allow staff photo uploads and reads
    match /staff-photos/{employeeId} {
      allow read, write: if true; // Allow public access for staff photos
    }
    
    // Keep existing rules for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
