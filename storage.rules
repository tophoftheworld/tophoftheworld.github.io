rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staff management profile photos
    match /staff-photos/{employeeId} {
      allow read, write: if true;
    }

    // Staff GoTyme QR codes (payroll transfers)
    match /staff-gotyme-qr/{employeeId} {
      allow read, write: if true;
    }

    // Staff BDO QR codes (payroll transfers)
    match /staff-bdo-qr/{employeeId} {
      allow read, write: if true;
    }

    match /menu-creator-photos/{fileName} {
      allow read, write: if true;
    }

    // Allow access to payment_confirmations folder
    match /payment_confirmations/{allPaths=**} {
      allow read, write: if true;
    }

    // Admin payroll v2 payment screenshots (canonical admin-payroll)
    match /payroll_periods_v2_screenshots/{allPaths=**} {
      allow read, write: if true;
    }

    // Admin payroll v2 payment statement PDFs (email download links)
    match /payroll_periods_v2_statements/{allPaths=**} {
      allow read, write: if true;
    }

    // Matcha Hop log photos
    match /logs/{allPaths=**} {
      allow read, write: if true;
    }

    // Matcha Hop / Chakaiki event cover photos
    match /events/{allPaths=**} {
      allow read, write: if true;
    }

    // Matcha Hop / Chakaiki brand logos (Add Brand thumbnail)
    match /brandLogos/{allPaths=**} {
      allow read, write: if true;
    }

    // Matcha Hop Google place photos (cached from Places API)
    match /placePhotos/{allPaths=**} {
      allow read, write: if true;
    }

    // Matcha Hop user profile avatars
    match /profiles/{allPaths=**} {
      allow read, write: if true;
    }

    // Matcha Hop list entry photos
    match /lists/{allPaths=**} {
      allow read, write: if true;
    }

    // Expense tracker receipt photos
    match /expense-receipts/{allPaths=**} {
      allow read, write: if true;
    }

    // Customer invoice payment screenshots (Admin SDK writes; public read for staff thumbs)
    match /invoice-payment-proofs/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Staff reimbursement claim receipts (payroll requests)
    match /reimbursement-receipts/{allPaths=**} {
      allow read, write: if true;
    }

    // Story giveaway entry screenshots
    match /story-giveaway/{allPaths=**} {
      allow read, write: if true;
    }

    // Digital photobooth captures (QR download)
    match /photobooth/{allPaths=**} {
      allow read, write: if true;
    }

    // MMF 2026 merchant registration uploads
    match /mmf-merchant-proofs/{allPaths=**} {
      allow read, write: if true;
    }

    match /mmf-merchant-docs/{allPaths=**} {
      allow read, write: if true;
    }

    match /mmf-merchant-requirements/{allPaths=**} {
      allow read, write: if true;
    }

    // Default rule for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
