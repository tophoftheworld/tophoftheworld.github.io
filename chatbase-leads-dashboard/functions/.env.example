FIREBASE_PROJECT_ID=matchanese-attendance
# Optional local Firestore: path to service account JSON (or run gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
CHATBASE_API_KEY=replace_me
CHATBASE_CHATBOT_ID=replace_me
ADMIN_API_TOKEN=replace_with_strong_secret
CHATBASE_MAX_PAGES=50
CHATBASE_PAGE_SIZE=50
CHATBASE_ACTION_SECRET=replace_with_long_random_secret_for_custom_action
SHOPIFY_SHOP=your-store-subdomain
SHOPIFY_ACCESS_TOKEN=replace_me
# Or OAuth client credentials instead of SHOPIFY_ACCESS_TOKEN:
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2024-10

# Inbox summary email (EmailJS — same account as daily-sales)
# Enable Account → Security → "Allow EmailJS API for non-browser applications"
# Create a template with {{{summary_html}}} (triple braces = raw HTML), {{subject}}, {{to_email}}, {{from_name}}
EMAILJS_SERVICE_ID=service_1085n74
EMAILJS_PUBLIC_KEY=Jxzqofh9mPAsb9V0M
# Store EMAILJS_PRIVATE_KEY in Secret Manager (and functions/.env.local for emulators).
# Do not put *_KEY secrets in functions/.env — they conflict with defineSecret on deploy.
EMAILJS_PRIVATE_KEY=replace_with_emailjs_private_key
EMAILJS_SUMMARY_TEMPLATE_ID=replace_with_summary_template_id
SUMMARY_EMAIL_TO=hi@matchanese.com

# Discord incoming webhooks (one per channel). Display names in Discord cannot contain the word "discord".
DISCORD_INBOX_WEBHOOK_URL=
DISCORD_INQUIRIES_WEBHOOK_URL=
DISCORD_ORDERS_WEBHOOK_URL=

# Workshop Sheets (optional) — reuse GOOGLE_SA_KEY for Event calendar sync
# GOOGLE_SA_KEY={"type":"service_account",...}
# WORKSHOP_SHEETS_DRIVE_ID=
# Event Management Google Calendar (optional). Share calendar with SA email as writer.
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
